---
import { WebsiteConfig } from "../../config";
import {
  getLangFromUrl,
  useTranslations,
  useTranslatedPath,
} from "../../i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const getPath = useTranslatedPath(lang);
---

<div
  class="jumbo h-[90vh] md:h-[100vh] flex flex-col content-center justify-center border-b-yellow border-b-4 max-h-[1300px]"
>
  <div
    class="flex flex-col content-center justify-center top-0 left-0 right-0 h-[100%] w-full"
  >
    <div
      class="absolute left-1/2 top-[80px] transform -translate-x-1/2 p-10 text-center text-primary-content flex flex-col align-center z-20 w-full max-h-[1300px]"
    >
      <img
        src="/assets/vectors/logo_yellow.svg"
        class="h-36 m-1 my-12 md:m-12"
      />
      <p class="text-2xl md:text-4xl font-semibold">
        {
          WebsiteConfig.EVENT_START.toLocaleDateString(lang, {
            timeZone: WebsiteConfig.EVENT_TIMEZONE,
            day: "numeric",
            month: "long",
            year: "numeric",
          })
        }
      </p>
      <p class="text-2xl md:text-4xl font-semibold">{t("info.locationName")}</p>
      <div
        class="mt-12 flex gap-4 justify-center flex-col md:flex-row flex-wrap"
      >
        {
          WebsiteConfig.SHOW_EVENT_TICKETS && (
            <a
              class="not-colored bg-white btn text-xl sm:p-6 p-8 sm:px-8 px-16 flex flex-col content-center"
              target="_blank"
              onclick="document.getElementById('tickets').scrollIntoView();location.hash='#tickets'"
            >
              <img src="/assets/vectors/ticket.svg" class="h-9 mr-2" />
              {t("hero.ticketsAvailable")}
              <div class="ml-1" />
            </a>
          )
        }
        {
          WebsiteConfig.THANKS_TO_ALL_TEXT && (
            <p class="text-2xl md:text-4xl font-semibold mt-8">
              {t("hero.thankYou")}
            </p>
          )
        }
        {
          /*
            <a
              class="not-colored bg-white btn text-xl sm:p-6 p-8 sm:px-8 px-16 flex flex-col content-center"
              target="_blank"
              onclick="document.getElementById('gallery').scrollIntoView();location.hash='#gallery'"
            >
              <img src="/assets/vectors/camera.svg" class="h-9 mr-2" />
              {t("hero.photoAvailable")}
              <div class="ml-1" />
            </a>
        <a
          class="not-colored bg-white btn text-xl sm:p-6 p-8 sm:px-8 px-16 flex flex-col content-center"
          href="https://app.bari.devfest.it"
          target="_blank"
        >
          <img src="/assets/vectors/web_logo_black.svg" class="h-9 mr-2" />
          {t("hero.webApp")}
          <div class="ml-1"></div>
        </a>

        <a
          class="not-colored bg-white btn text-xl sm:p-6 p-8 sm:px-8 px-16 flex flex-col content-center"
          href={getPath("/qrcode", lang)}
        >
          <img src="/assets/vectors/logo_compact.svg" class="h-9 mr-2" />
          {t("hero.qrCode")}
          <div class="ml-1"></div>
        </a>
              */
        }
      </div>
    </div>
    <div
      class="wheel-container max-w-[2500px] flex content-center justify-center mx-auto"
    >
      <!-- <div class="bg-black md:block hidden absolute bottom-0 left-0 right-0 w-full h-full z-10 bg-opacity-50"></div> -->
      <img
        src="/assets/vectors/skyline-parts/skyline-fireworks-wheel.png"
        alt=""
        class="mt-auto absolute bottom-0 left-0 right-0 w-full wheel-rotate-animation"
      />
      <img
        src="/assets/vectors/skyline-parts/skyline-fireworks-base.png"
        alt=""
        class="mt-auto absolute bottom-0 left-0 right-0 w-full"
      />
    </div>
  </div>
</div>
