---
import type { ScheduleDay } from "../../data/types/sessionize";
import { getLangFromUrl } from "../../i18n/utils";
import ScheduleCard from "./ScheduleCard.astro";
import { capitalizeFirstLetter } from "../../react/utils";
import { WebsiteConfig } from "../../config";

interface Props {
  schedule: ScheduleDay[];
  rooms?: number[];
}

const lang = getLangFromUrl(Astro.url);
const { schedule, rooms } = Astro.props;

const calcSlotsTaken = (timeSlots, tsr, ts_idx) => {
  const endDate = new Date(tsr.session.endsAt);
  endDate.setSeconds(0);
  endDate.setMilliseconds(0);
  //Calculate the space to take (how many timeSlot takes this session (until a service session))
  let session_len = 1;
  let last_is_service = false;
  for (let i = ts_idx + 1; i < timeSlots.length; i++) {
    //No sessions
    if (timeSlots[i].rooms.length == 0) continue;
    //Take time from one of the sessions
    //Get next start date
    const next_date = new Date(timeSlots[i].rooms[0].session.startsAt);
    next_date.setSeconds(0);
    next_date.setMilliseconds(0);
    //If it's a service session, can't take this space
    if (timeSlots[i].rooms.some((tsr) => tsr.session.isServiceSession)) {
      last_is_service = true;
      continue; //We need to check if replicate this session for the next timeSlot that is not a service session
    }
    if (last_is_service) {
      //We stopped at a service session and need to check if replicate this session in next timeSlots
      if (next_date < endDate) {
        timeSlots[i].rooms.push(tsr); //Replicate
      }
      break;
    }
    //Continue to get space until this session ends
    if (next_date < endDate) {
      session_len++;
    } else {
      break;
    }
  }
  return session_len;
};

const isServiceTimeSlot = (ts) =>
  ts.rooms.some((tsr) => tsr.session.isServiceSession);
---

<div>
  {
    schedule.map((s) => {
      const roomsSelected = rooms
        ? s.rooms.filter((r) => rooms.includes(r.id))
        : s.rooms;
      const timeSlotSelected = s.timeSlots.filter((ts, index) => {
        const hasSelectedRoom = ts.rooms.some((tsr) =>
          roomsSelected.map((r) => r.id).includes(tsr.id),
        );
        const isService = isServiceTimeSlot(ts);

        // Include anche il primo timeslot tra due sessioni di servizio
        const isFirstSlotAfterService =
          index > 0 &&
          index < s.timeSlots.length - 1 &&
          isServiceTimeSlot(s.timeSlots[index - 1]);

        return hasSelectedRoom || isService || isFirstSlotAfterService;
      });

      // Filtra le room che hanno almeno una sessione non-service
      const roomsWithContent = roomsSelected.filter((room) => {
        return timeSlotSelected.some((ts) => {
          return ts.rooms.some(
            (tsr) => tsr.id === room.id && !tsr.session.isServiceSession,
          );
        });
      });

      const totalScheduleCols = roomsWithContent.length;
      let skipPadding: { [key: string]: number } = roomsWithContent
        .map((room) => ({ [room.id]: 0 }))
        .reduce((a, b) => ({ ...a, ...b }), {});
      return (
        <>
          <div class="mb-5">
            <p class="text-3xl font-bold mb-5">
              {capitalizeFirstLetter(
                new Date(s.date).toLocaleDateString(lang, {
                  timeZone: WebsiteConfig.EVENT_TIMEZONE,
                  day: "numeric",
                  month: "long",
                  weekday: "long",
                }),
              )}
            </p>
            {/* Some classes are created manually due to tilewind issues */}
            <div class="schedule-day-container">
              <div
                class="overflow-x-auto schedule-scroll-container"
                data-rooms-count={totalScheduleCols}
              >
                <div
                  class={`grid grid-flow-row grid-cols-layout-${totalScheduleCols} grid-cols-1 gap-4`}
                >
                  {timeSlotSelected.map((ts, ts_idx) => {
                    const hasServiceSession = isServiceTimeSlot(ts);

                    // Filtra le room: include le room con contenuto + tutte le sessioni di servizio
                    const roomsToRender = ts.rooms.filter(
                      (tsr) =>
                        tsr.session.isServiceSession ||
                        roomsWithContent.map((r) => r.id).includes(tsr.id),
                    );

                    const sessionsInTimeSlot = roomsToRender.map((tsr) => {
                      const slots = !hasServiceSession
                        ? calcSlotsTaken(timeSlotSelected, tsr, ts_idx)
                        : 1;
                      if (slots > 1) {
                        skipPadding[tsr.id.toString()] = slots - 1;
                      }

                      // Calcola i timestamp specifici per questo blocco grafico
                      // Usa direttamente i tempi della sessione originale
                      const sessionStartTime = new Date(tsr.session.startsAt);
                      const sessionEndTime = new Date(tsr.session.endsAt);

                      // Per sessioni multi-slot, usa il tempo di inizio del primo slot e calcola la fine
                      let blockStartTime, blockEndTime;

                      // Calcola il tempo di inizio del blocco considerando service sessions precedenti
                      blockStartTime = sessionStartTime; // Default: inizio naturale della sessione
                      for (let i = ts_idx - 1; i >= 0; i--) {
                        const prevSlot = timeSlotSelected[i].rooms.find(
                          (r) => r.session.isServiceSession,
                        );
                        if (prevSlot) {
                          // Trova la service session più recente, usa la sua fine come inizio del blocco
                          const endSessionTime = new Date(
                            prevSlot.session.endsAt,
                          );
                          if (endSessionTime > blockStartTime) {
                            blockStartTime = endSessionTime;
                          }
                          break; // Prendi la più recente e fermati
                        }
                      }

                      // Cerca il prossimo slot non vuoto tra tutti i successivi
                      blockEndTime = sessionEndTime; // Default fallback
                      for (
                        let i = ts_idx + 1;
                        i < timeSlotSelected.length;
                        i++
                      ) {
                        const nextSlot = timeSlotSelected[i].rooms.find(
                          (r) => r.session.isServiceSession,
                        );
                        if (nextSlot) {
                          const nextServiceStart = new Date(
                            nextSlot.session.startsAt,
                          );
                          if (nextServiceStart < blockEndTime) {
                            blockEndTime = nextServiceStart;
                          }
                          break;
                        }
                      }

                      return {
                        data: tsr,
                        html: (
                          <>
                            <div
                              class={`xl:col-span-${hasServiceSession ? totalScheduleCols : 1} row-span-${slots}`}
                            >
                              <ScheduleCard
                                value={tsr}
                                blockStartTime={blockStartTime.toISOString()}
                                blockEndTime={blockEndTime.toISOString()}
                              />
                            </div>
                          </>
                        ),
                      };
                    });

                    const orderedSessions = !hasServiceSession
                      ? roomsWithContent
                          .map((room) => {
                            let session = sessionsInTimeSlot.find(
                              (target) => room.id == target.data.id,
                            );
                            if (!session) {
                              if (skipPadding[room.id.toString()]) {
                                skipPadding[room.id.toString()]--;
                                return null;
                              }
                              return (
                                <>
                                  <div />
                                </>
                              );
                            }
                            return session?.html;
                          })
                          .filter((ele) => ele != null)
                      : sessionsInTimeSlot.map((session) => session.html);

                    const timeSlotElement = (
                      <div
                        class="font-medium text-2xl time-slot"
                        data-slot-time={ts.slotStart}
                        data-schedule-date={s.date}
                      >
                        <p>{ts.slotStart}</p>
                      </div>
                    );

                    return [timeSlotElement, ...orderedSessions];
                  })}
                </div>
              </div>
            </div>
          </div>
        </>
      );
    })
  }
  <style>
    /* Scroll container styling */
    .overflow-x-auto {
      scrollbar-width: thin;
      scrollbar-color: rgba(66, 133, 244, 0.5) rgba(0, 0, 0, 0.1);
      cursor: grab;
    }

    .overflow-x-auto.cursor-grabbing {
      cursor: grabbing;
      user-select: none;
    }

    .overflow-x-auto .schedule-card {
      cursor: pointer;
      user-select: none;
    }

    .overflow-x-auto::-webkit-scrollbar {
      height: 10px;
    }

    .overflow-x-auto::-webkit-scrollbar-track {
      background: rgba(0, 0, 0, 0.05);
      border-radius: 5px;
    }

    .overflow-x-auto::-webkit-scrollbar-thumb {
      background: rgba(66, 133, 244, 0.5);
      border-radius: 5px;
      transition: background 0.3s;
    }

    .overflow-x-auto::-webkit-scrollbar-thumb:hover {
      background: rgba(66, 133, 244, 0.8);
    }

    @media (min-width: 1280px) {
      .grid-cols-layout-1 {
        grid-template-columns: 90px repeat(1, minmax(auto, 1fr));
      }
      .grid-cols-layout-2 {
        grid-template-columns: 90px repeat(2, minmax(auto, 1fr));
      }
      .grid-cols-layout-3 {
        grid-template-columns: 90px repeat(3, minmax(auto, 1fr));
      }
      .grid-cols-layout-4 {
        grid-template-columns: 90px repeat(4, minmax(auto, 1fr));
      }
      .grid-cols-layout-5 {
        grid-template-columns: 90px repeat(5, minmax(auto, 1fr));
      }
      .grid-cols-layout-6 {
        grid-template-columns: 90px repeat(6, minmax(auto, 1fr));
      }
      .grid-cols-layout-7 {
        grid-template-columns: 90px repeat(7, minmax(auto, 1fr));
      }
      .grid-cols-layout-8 {
        grid-template-columns: 90px repeat(8, minmax(auto, 1fr));
      }
      .grid-cols-layout-9 {
        grid-template-columns: 90px repeat(9, minmax(auto, 1fr));
      }
      .grid-cols-layout-10 {
        grid-template-columns: 90px repeat(10, minmax(auto, 1fr));
      }
    }
  </style>
  <script>
    function initDragScroll() {
      const scrollContainers = document.querySelectorAll(
        ".schedule-scroll-container",
      );

      scrollContainers.forEach((container) => {
        let isDown = false;
        let startX: number;
        let scrollLeft: number;
        let hasMoved = false;

        container.addEventListener("mousedown", (e) => {
          isDown = true;
          hasMoved = false;
          container.classList.add("cursor-grabbing");
          startX =
            (e as MouseEvent).pageX - container.getBoundingClientRect().left;
          scrollLeft = container.scrollLeft;
        });

        container.addEventListener("mouseleave", () => {
          isDown = false;
          container.classList.remove("cursor-grabbing");
        });

        container.addEventListener("mouseup", () => {
          isDown = false;
          container.classList.remove("cursor-grabbing");
        });

        container.addEventListener("mousemove", (e) => {
          if (!isDown) return;
          e.preventDefault();
          const x =
            (e as MouseEvent).pageX - container.getBoundingClientRect().left;
          const walk = (x - startX) * 2;

          if (Math.abs(walk) > 5) {
            hasMoved = true;
          }

          container.scrollLeft = scrollLeft - walk;
        });

        // Previeni il click sui link solo se c'è stato drag significativo
        container.addEventListener(
          "click",
          (e) => {
            if (hasMoved) {
              e.preventDefault();
              e.stopPropagation();
              hasMoved = false;
            }
          },
          true,
        );

        // Previeni il drag nativo del browser sui link
        container.querySelectorAll("a").forEach((link) => {
          link.addEventListener("dragstart", (e) => {
            e.preventDefault();
          });
        });
      });
    }

    // Initialize on page load
    initDragScroll();

    // Re-initialize on Astro page transitions
    document.addEventListener("astro:page-load", initDragScroll);
  </script>
</div>
