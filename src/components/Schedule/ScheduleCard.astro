---
import type { ScheduleSlotRoom } from "../../data/types/sessionize";
import { ImportSvg } from "../../helpers/svgimport";
import {
  getLangFromUrl,
  useTranslatedPath,
  useTranslations,
} from "../../i18n/utils";

interface Props {
  value: ScheduleSlotRoom;
  blockStartTime?: string;
  blockEndTime?: string;
}

const { value, blockStartTime, blockEndTime } = Astro.props;
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const getPath = useTranslatedPath(lang);

const hasSpeakers = value.session.info && value.session.info.speakers;

const url = !value.session.isServiceSession
  ? `/sessions/${value.session.info?.slug}`
  : null;

// Debug option - set to true to show timing data in title
const DEBUG_SHOW_TIMING = false;
const sessionStart = blockStartTime || value.session.startsAt;
const sessionEnd = blockEndTime || value.session.endsAt;

// Calcola la durata della sessione usando sempre i tempi originali
const dateStart = new Date(value.session.startsAt);
const dateEnd = new Date(value.session.endsAt);
const duration = dateEnd.getTime() - dateStart.getTime();
const minDuration = Math.floor(duration / (1000 * 60));
const durationHours = Math.floor(minDuration / 60);
const durationMinutes = minDuration % 60;

const translationIcon = await ImportSvg("translation");
---

<a
  href={url ? getPath(url) : null}
  class={`schedule-card not-colored p-4 border border-gray-400 rounded-md ${
    value.session.isServiceSession ? "h-52" : "xl:h-full md:h-52"
  } flex flex-col transition-all duration-200 min-w-0`}
  data-session-start={blockStartTime || value.session.startsAt}
  data-session-end={blockEndTime || value.session.endsAt}
  data-room-id={value.id}
  data-original-start={value.session.startsAt}
  data-original-end={value.session.endsAt}
  data-is-block-part={blockStartTime ? "true" : "false"}
>
  {!value.session.isServiceSession && <p class="mb-2 truncate">{value.name}</p>}
  <p class="text-xl font-medium break-words overflow-wrap-anywhere">
    {
      DEBUG_SHOW_TIMING
        ? `${value.session.title} ${blockStartTime ? "🔗" : "📅"} [${new Date(sessionStart).toLocaleTimeString("it-IT", { hour: "2-digit", minute: "2-digit" })} - ${new Date(sessionEnd).toLocaleTimeString("it-IT", { hour: "2-digit", minute: "2-digit" })}]`
        : value.session.title
    }
  </p>
  {
    DEBUG_SHOW_TIMING && (
      <div class="text-xs opacity-60 mt-1">
        <span class="bg-gray-800 px-2 py-1 rounded text-yellow-300">
          DEBUG: start={sessionStart} | end={sessionEnd}
        </span>
      </div>
    )
  }
  <div class="flex-1"></div>
  {
    !value.session.isServiceSession && (
      <div class="flex flex-col gap-2 mt-4 text-sm">
        {value.session.info?.language && (
          <div class="flex gap-2 items-center">
            <div class="w-4">
              <svg class="fill-current h-6 w-6" set:html={translationIcon} />
            </div>
            <div>{value.session.info?.language}</div>
          </div>
        )}
        {minDuration > 0 && (
          <div class="flex gap-2 items-center">
            <div class="w-4">
              <img
                src="/assets/vectors/time.svg"
                alt="session duration"
                class="brightness-0 invert"
                style="filter: brightness(0) invert(1);"
              />
            </div>
            <div class="font-semibold">
              {durationHours > 0 &&
                `${durationHours} ${t("sessions.shortHours")}`}
              {durationHours > 0 && durationMinutes > 0 && " "}
              {durationMinutes > 0 &&
                `${durationMinutes} ${t("sessions.shortMinutes")}`}
            </div>
          </div>
        )}
      </div>
    )
  }
  <div class="flex flex-row mt-auto justify-between align-center">
    {value.session.isServiceSession && <p class="opacity-60">{value.name}</p>}
    <div class="mt-4 flex flex-col gap-2">
      {
        hasSpeakers &&
          value.session.info?.speakers!.map((speaker) => (
            <div class="flex flex-row">
              <div class="flex-none w-10 pr-3">
                <img
                  class="rounded-full"
                  src={speaker.profilePicture}
                  alt={speaker.fullName}
                />
              </div>

              <div class="flex-1">
                <p class="text-md">{speaker.fullName}</p>
              </div>
            </div>
          ))
      }
    </div>
  </div>
</a>
